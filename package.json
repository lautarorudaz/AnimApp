{
  "name": "animapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/routines.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-animapp \"node --test tests/firestore.rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-animapp \"playwright test\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-animapp \"node tests/integration.mjs\""
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
