rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userProfilePath(request.auth.uid));
    }

    function profile() {
      return get(userProfilePath(request.auth.uid)).data;
    }

    function isActive() {
      return hasProfile() && profile().activo == true;
    }

    function hasRole(role) {
      return isActive() && profile().rol == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function profileHasSede(sedeId) {
      return isAdmin()
        || (
          isActive()
          && (
            ('sedeIds' in profile().keys() && profile().sedeIds.hasAny([sedeId]))
            || ('sedes' in profile().keys() && profile().sedes.hasAny([sedeId]))
          )
        );
    }

    function isProfesorForSede(sedeId) {
      return profileHasSede(sedeId) && hasRole('profesor');
    }

    function isRecepcionForSede(sedeId) {
      return profileHasSede(sedeId) && hasRole('recepcionista');
    }

    function isAssignedProfessor(alumnoId, sedeId) {
      let alumnoPath = /databases/$(database)/documents/alumnos/$(alumnoId);
      return isProfesorForSede(sedeId)
        && exists(alumnoPath)
        && get(alumnoPath).data.sedeId == sedeId
        && get(alumnoPath).data.profesorId == request.auth.uid;
    }

    match /sedes/{sedeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId)
        || (
          hasRole('recepcionista')
          && resource.data.rol in ['profesor', 'alumno']
          && resource.data.activo == true
          && resource.data.sedeIds.hasAny(profile().sedeIds)
        );
      allow create: if isAdmin()
        || (
          hasRole('recepcionista')
          && request.resource.data.uid == userId
          && request.resource.data.rol == 'alumno'
          && request.resource.data.sedeIds.size() == 1
          && request.resource.data.sedeIds.hasAny(profile().sedeIds)
        );

      allow update: if isAdmin()
        || (
          hasRole('recepcionista')
          && resource.data.rol == 'alumno'
          && resource.data.sedeIds.hasAny(profile().sedeIds)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['activo', 'active', 'eliminado', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    match /alumnos/{alumnoId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.userId)
        || isRecepcionForSede(resource.data.sedeId)
        || (
          isProfesorForSede(resource.data.sedeId)
          && resource.data.profesorId == request.auth.uid
        );

      allow create: if isAdmin() || isRecepcionForSede(request.resource.data.sedeId);

      allow update: if isAdmin()
        || (
          isRecepcionForSede(resource.data.sedeId)
          && request.resource.data.sedeId == resource.data.sedeId
        )
        || (
          isProfesorForSede(resource.data.sedeId)
          && resource.data.profesorId == request.auth.uid
          && request.resource.data.sedeId == resource.data.sedeId
          && request.resource.data.profesorId == resource.data.profesorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rutinaId', 'rutinaNombre', 'objetivo', 'frecuenciaSemanal',
            'rutinaIndicaciones', 'rutinaEjercicios', 'rutinaActualizadaAt',
            'rutinaEstructura', 'updatedAt', 'updatedBy'
          ])
        );

      allow delete: if isAdmin() || isRecepcionForSede(resource.data.sedeId);
    }

    match /ejercicios/{ejercicioId} {
      allow read: if isAdmin()
        || (
          hasRole('profesor')
          && (resource.data.privado == false || resource.data.profesorId == request.auth.uid)
        );

      allow create: if isAdmin()
        || (
          hasRole('profesor')
          && request.resource.data.profesorId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          hasRole('profesor')
          && resource.data.profesorId == request.auth.uid
          && request.resource.data.profesorId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (hasRole('profesor') && resource.data.profesorId == request.auth.uid);
    }

    match /zonasMusculares/{zonaId} {
      allow read: if isActive();
      allow create: if hasRole('profesor')
        && request.resource.data.creadoPor == request.auth.uid;
      allow update, delete: if isAdmin()
        || (hasRole('profesor') && resource.data.creadoPor == request.auth.uid);
    }

    match /rutinas/{rutinaId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == resource.data.alumnoUserId)
        || (
          resource.data.profesorId == request.auth.uid
          && isAssignedProfessor(resource.data.alumnoId, resource.data.sedeId)
        );

      allow create: if isAdmin()
        || (
          request.resource.data.profesorId == request.auth.uid
          && isAssignedProfessor(request.resource.data.alumnoId, request.resource.data.sedeId)
        );

      allow update: if isAdmin()
        || (
          resource.data.profesorId == request.auth.uid
          && request.resource.data.profesorId == request.auth.uid
          && request.resource.data.alumnoId == resource.data.alumnoId
          && request.resource.data.sedeId == resource.data.sedeId
          && isAssignedProfessor(resource.data.alumnoId, resource.data.sedeId)
        );

      allow delete: if isAdmin()
        || (
          resource.data.profesorId == request.auth.uid
          && isAssignedProfessor(resource.data.alumnoId, resource.data.sedeId)
        );
    }

    match /rutinasGenericas/{rutinaId} {
      allow read: if isAdmin()
        || (hasRole('profesor') && resource.data.profesorId == request.auth.uid);

      allow create: if isAdmin()
        || (
          hasRole('profesor')
          && request.resource.data.profesorId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          hasRole('profesor')
          && resource.data.profesorId == request.auth.uid
          && request.resource.data.profesorId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (hasRole('profesor') && resource.data.profesorId == request.auth.uid);
    }

    match /stockItems/{itemId} {
      allow read: if isAdmin() || isRecepcionForSede(resource.data.sedeId);

      allow create: if isAdmin() || isRecepcionForSede(request.resource.data.sedeId);

      allow update, delete: if isAdmin()
        || (
          isRecepcionForSede(resource.data.sedeId)
          && request.resource.data.sedeId == resource.data.sedeId
        );
    }

    match /stockMovimientos/{movimientoId} {
      allow read: if isAdmin() || isRecepcionForSede(resource.data.sedeId);

      allow create: if (isAdmin() || isRecepcionForSede(request.resource.data.sedeId))
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
